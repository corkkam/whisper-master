# Copy to `.env` and fill in. `.env` is git-ignored; this template is committed.
# Cloudflare R2 credentials for uploading Sparkle release artifacts.

# --- SECRETS (R2 → Manage R2 API Tokens → "Object Read & Write") ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Non-secret config ---
R2_BUCKET=whisper-master-macos
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Public read URL for the same bucket. Must match the host baked into
# SUFeedURL (Scripts/channel.sh) and ModelInstaller.mirrorBaseURL, or the app
# polls a feed nobody publishes to.
R2_PUBLIC_BASE_URL=https://dl.corkkam.com

# --- Product analytics (PostHog) ---
# Project API key (starts phc_). Publishable/client-side, not a secret, but kept
# out of source. bundle.sh reads this and bakes it into Info.plist at build time.
# Leave blank to build with analytics dormant. Region host defaults to US cloud;
# override in-app via WHISPERMASTER_POSTHOG_HOST if you're on EU.
POSTHOG_API_KEY=

# --- PostHog dashboards (local / operator machine only; not shipped) ---
# Personal API key (starts phx_), *not* the project key above. Needed by
# Scripts/setup-analytics-dashboards.py to create/update the Mac App
# dashboards. Scope to dashboard:write, insight:write, project:read.
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://us.posthog.com

# --- PostHog crash symbolication (release machines / CI only) ---
# Uploads the release build's dSYM so native crash stacks arrive symbolicated
# instead of as hex addresses (Scripts/release.sh → upload-symbols). Unlike the
# key above this is NOT shipped in the app and NOT publishable: it is a personal
# API key. Scope it to `error_tracking:write` and nothing else, so a leak can
# only write symbol sets.
#
# Needs the CLI: npm install -g @posthog/cli   (>= 0.7.7)
# Leave blank to skip the upload — release.sh warns loudly rather than failing,
# but every crash from that build is then permanently unsymbolicated.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
# US cloud by default; set to https://eu.posthog.com on EU.
# POSTHOG_CLI_HOST=https://us.posthog.com

# --- Google Analytics 4 (Measurement Protocol + dashboard setup) ---
# Web data stream "whisper-master-mac-app" — a stream of its own, not the
# landing page's. bundle.sh bakes both into Info.plist; GA stays dormant
# until both look real. The API secret writes events only; it is extractable
# from a downloaded .app, so keep it on this disposable stream.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA_API_SECRET=
# Optional. Scripts/setup-analytics-dashboards.py discovers it from the
# measurement ID; set it to skip the account-summaries walk.
# GA_PROPERTY_ID=

# --- Apple notarization (local releases) ---
# Easiest: save a reusable keychain profile once and reference it by name:
#   xcrun notarytool store-credentials whisper-notary \
#     --key AuthKey_XXXX.p8 --key-id <KEY_ID> --issuer <ISSUER_UUID>
NOTARY_PROFILE=whisper-notary
# ...or point straight at an App Store Connect API key instead of a profile:
# NOTARY_KEY_P8=/absolute/path/AuthKey_XXXX.p8
# NOTARY_KEY_ID=
# NOTARY_ISSUER=
