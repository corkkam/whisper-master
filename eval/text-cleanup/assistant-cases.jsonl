{"id": "asst-calendar-tomorrow", "category": "calendar", "input": "what's on my calendar tomorrow", "targets": ["assistant", "assistant-native"], "must_contain": ["list_calendar_events"], "note": "plain read of a connected calendar"}
{"id": "asst-slack-late", "category": "message", "input": "send a slack to the ops channel saying I'll be late", "targets": ["assistant", "assistant-native"], "must_contain": ["send_message"], "note": "write to a chat connector"}
{"id": "asst-remind-call", "category": "reminder", "input": "remind me to call mom at 6", "targets": ["assistant", "assistant-native"], "must_contain": ["create_reminder"], "note": "local tool, explicit time"}
{"id": "asst-calendar-create", "category": "calendar", "input": "add a dentist appointment to my personal calendar friday at 3", "targets": ["assistant", "assistant-native"], "must_contain": ["create_calendar_event"], "note": "names one of two calendars"}
{"id": "asst-mail-unread", "category": "mail", "input": "what are my unread emails", "targets": ["assistant", "assistant-native"], "must_contain": ["list_mail"], "note": "read of a mail connector"}
{"id": "asst-tasks-mine", "category": "tasks", "input": "what tasks are assigned to me", "targets": ["assistant", "assistant-native"], "must_contain": ["list_tasks"], "note": "issue tracker read"}
{"id": "asst-messages-recent", "category": "message", "input": "show me my recent messages", "targets": ["assistant", "assistant-native"], "must_contain": ["list_messages"], "note": "chat read, easily confused with list_mail"}
{"id": "asst-note-wifi", "category": "note", "input": "make a note that the wifi password is basalt harbor nineteen", "targets": ["assistant", "assistant-native"], "must_contain": ["create_note"], "note": "local tool, verbatim body"}
{"id": "asst-drive-files", "category": "files", "input": "what files are in my drive", "targets": ["assistant", "assistant-native"], "must_contain": ["list_files"], "note": "file connector read"}
{"id": "asst-connectors", "category": "meta", "input": "what accounts do i have connected", "targets": ["assistant", "assistant-native"], "must_contain": ["list_connectors"], "note": "asks about the app itself, not a connector"}
{"id": "asst-slack-build", "category": "message", "input": "post to the eng channel that the build is green", "targets": ["assistant", "assistant-native"], "must_contain": ["send_message"], "note": "post is a synonym for send"}
{"id": "asst-remind-report", "category": "reminder", "input": "remind me to submit the report tomorrow morning", "targets": ["assistant", "assistant-native"], "must_contain": ["create_reminder"], "note": "vague time, still a reminder"}
{"id": "asst-messy-meetings", "category": "dictation-shaped", "input": "uh can you check what meetings I've got going on later today", "targets": ["assistant", "assistant-native"], "must_contain": ["list_calendar_events"], "note": "filler and a run-on"}
{"id": "asst-messy-selfcorrect", "category": "dictation-shaped", "input": "message the design channel no wait the ops channel and tell them the deploy is done", "targets": ["assistant", "assistant-native"], "must_contain": ["send_message"], "note": "self-correction mid-command; the ops channel is the one that counts"}
{"id": "asst-messy-book", "category": "dictation-shaped", "input": "book thirty minutes with the personal calendar for a review tomorrow at four", "targets": ["assistant", "assistant-native"], "must_contain": ["create_calendar_event"], "note": "duration and calendar named in passing"}
{"id": "asst-messy-jot", "category": "dictation-shaped", "input": "just jot down that I should follow up with the vendor about pricing", "targets": ["assistant", "assistant-native"], "must_contain": ["create_note"], "note": "a bare thought with nothing to act on but a note"}
