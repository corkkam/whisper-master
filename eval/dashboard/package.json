{
  "name": "eval-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "History + browser for dictation-cleanup eval runs (SvelteKit + Prisma + MongoDB).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "node build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "push-run": "node scripts/push-run.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "prisma": "^6.19.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  }
}
