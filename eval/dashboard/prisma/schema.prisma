// Prisma 6 + MongoDB (no driver adapter needed on 6.x). Run `prisma db push`
// once DATABASE_URL points at your Atlas cluster — Mongo has no migrations.
generator client {
  provider      = "prisma-client-js"
  // "native" for local dev + Vercel's serverless runtime (Node 20 / AL2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// One evaluation run — an ingested results.json plus its computed aggregate.
model Run {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime @default(now())
  label      String?
  gitCommit  String?
  branch     String?
  totalRuns  Int // number of case x target rows
  totalCases Int
  audioCases Int
  /// Rolled-up metrics: { byTarget: {light:{pass,total,latency}}, werBySource, attribution }
  aggregate  Json
  results    Result[]

  @@index([createdAt])
}

/// One scored case x target row within a run.
model Result {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId          String   @db.ObjectId
  caseId         String
  category       String?
  source         String // Text | TTS | LibriSpeech | Bluetooth | Noise
  target         String // light | polish
  inputKind      String // text | audio
  deterministic  String
  llmOutput      String
  guardAccepted  Boolean
  wer            Float?
  latencyMs      Json
  asrText        String?
  asrReference   String?
  mechanicalPass Boolean
  attribution    String? // asr | cleanup | null
  reasons        String[]

  @@index([runId])
}

/// A user's freeform note, upserted by the macOS app (last-writer-wins by
/// `updatedAt`). `deletedAt` is a soft-delete tombstone so a delete propagates.
/// Reads are Bearer-authenticated (NOT public) — notes are personal.
model Note {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String // Clerk user id (attribution)
  itemId    String // the app-side stable UUID
  title     String    @default("")
  body      String    @default("")
  createdAt DateTime
  updatedAt DateTime
  deletedAt DateTime?

  @@unique([userId, itemId])
  @@index([userId])
}

/// A user's time-based reminder, upserted by the macOS app (LWW by `updatedAt`).
model ReminderItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  itemId      String
  title       String    @default("")
  body        String    @default("")
  dueDate     DateTime
  alertStyle  String    @default("notification") // notification | alarm
  soundName   String    @default("Glass")
  repeatRule  String    @default("none") // none | daily | weekly
  isCompleted Boolean   @default(false)
  firedAt     DateTime?
  createdAt   DateTime
  updatedAt   DateTime
  deletedAt   DateTime?

  @@unique([userId, itemId])
  @@index([userId])
}

/// Per-user, per-day dictation usage rollup, upserted by the macOS app.
model UsageDaily {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String // Clerk user id (attribution)
  day                 String // local yyyy-MM-dd
  words               Int
  dictations          Int
  durationSeconds     Float
  fixesWordsCorrected Int      @default(0)
  fixesDictionary     Int      @default(0)
  perApp              Json // { "<bundleId>": { name, words, count }, ... }
  updatedAt           DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId])
}
