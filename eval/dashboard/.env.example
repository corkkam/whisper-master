# MongoDB Atlas connection string. Copy to .env and fill in.
# Format: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/eval?retryWrites=true&w=majority"

# Base URL the push-run script posts to (defaults to the dev server).
DASHBOARD_URL="http://localhost:5173"

# Shared secret that protects POST /api/ingest on the public deploy. When set,
# writes require an x-ingest-token header; push-run reads it from here. Generate
# with: openssl rand -hex 24
INGEST_TOKEN=""
