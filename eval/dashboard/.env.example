# MongoDB Atlas connection string. Copy to .env and fill in.
# Still backs eval Run/Result (and is the SOURCE for the one-time Phase-5
# migration script). Per-user sync data now lives in Supabase (below).
# Format: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/eval?retryWrites=true&w=majority"

# Supabase (Phase 5) — backs the per-user sync routes (/api/usage, /api/notes).
# Server-only service-role key; NEVER expose it to the browser. Same instance as
# the landing page. Schema: public (production) or dev.
SUPABASE_URL="https://ypazgzrxkrdbnbrqgxjk.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DB_SCHEMA="public"

# Base URL the push-run script posts to (defaults to the dev server).
DASHBOARD_URL="http://localhost:5173"

# Shared secret that protects POST /api/ingest on the public deploy. When set,
# writes require an x-ingest-token header; push-run reads it from here. Generate
# with: openssl rand -hex 24
INGEST_TOKEN=""

# Clerk backend auth for POST /api/usage (per-user attribution). When either
# CLERK_SECRET_KEY or CLERK_JWT_KEY is set, usage writes REQUIRE a verified Clerk
# session token (Authorization: Bearer <jwt>) and the userId is taken from the
# token's `sub` claim — body.userId is ignored and the x-ingest-token fallback is
# disabled. Leave both blank to keep the shared-token (INGEST_TOKEN) MVP mode.
#   CLERK_SECRET_KEY — sk_test_… / sk_live_…; enables a cached JWKS fetch.
#   CLERK_JWT_KEY    — optional PEM public key for networkless verification.
#   CLERK_AUTHORIZED_PARTIES — optional comma-separated azp allow-list.
CLERK_SECRET_KEY=""
CLERK_JWT_KEY=""
CLERK_AUTHORIZED_PARTIES=""
