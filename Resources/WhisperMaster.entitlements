<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Entitlements for the hardened runtime (required for notarization).
	  The app is NOT sandboxed, so only the capabilities it actually uses are
	  declared. Microphone is the one hardened-runtime-gated resource we touch;
	  text injection uses Accessibility (TCC), and local-network/Bonjour need no
	  entitlement for a non-sandboxed app.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
